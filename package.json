{
  "name": "baseline-today",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "sync:daily": "tsx --env-file=.env.local --conditions=react-server scripts/sync-daily.mts",
    "sync:photos": "tsx --env-file=.env.local --conditions=react-server scripts/sync-photos.mts",
    "test:e2e": "playwright test",
    "test:integration": "vitest run --mode integration",
    "trial:report": "tsx --env-file=.env.local --conditions=react-server scripts/trial-report.mts",
    "sync:results": "tsx --env-file=.env.local --conditions=react-server scripts/sync-results.mts",
    "sync:rankings-history": "tsx --env-file=.env.local --conditions=react-server scripts/sync-rankings-history.mts",
    "sync:tournaments": "tsx --env-file=.env.local --conditions=react-server scripts/sync-tournaments.mts",
    "audit:draws": "tsx --env-file=.env.local --conditions=react-server scripts/audit-draw-levels.mts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "flag-icons": "^7.5.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "supabase": "^2.119.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
