# Copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: never prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=
BALLDONTLIE_API_KEY=
# Production only (Vercel); protects /api/cron/daily
# CRON_SECRET=

# Optional: Discord or Slack webhooks for the daily digest and job alerts (comma-separated).
# Save to Vercel with: node scripts/webhook-env.mjs
# DIGEST_WEBHOOK_URLS=
